{
  "name": "zero-to-shipped-resume-parser",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "preview": "npm --prefix frontend run preview -- --host 0.0.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
